{
  // Type-checks Buddy's JavaScript through its JSDoc types; nothing is compiled (Electron runs the .js as is).
  // Every main-process module is listed; `npm run check` must pass.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": false,
    // Buddy's pages are classic scripts, each in its own window: checked as if each were a module, so their top-level
    // names (every page has a $) don't collide.
    "moduleDetection": "force"
  },
  "files": [
    "src/main.js",
    "src/approvals.js",
    "src/geometry.js",
    "src/modes.js",
    "src/desktop.js",
    "src/brain.js",
    "src/tasks.js",
    "src/voice.js",
    "src/speech.js",
    "src/models.js",
    "src/settings.js",
    "src/policy.js",
    "src/routines.js",
    "src/settings-window.js",
    "src/provider-state.js",
    "src/explainer-window.js",
    "src/launch.js",
    "src/feedback.js",
    "src/marker.js",
    "src/ai-app-setup.js",
    "src/app-bridge.js",
    "src/conversations.js",
    "src/updates.js",
    "src/speakable.js",
    "src/reply-stream.js",
    "src/turn-queue.js",
    "src/screen-context.js",
    "src/guidance.js",
    "src/annotations.js",
    "src/marker-stroke.js",
    "src/marker-startup.js",
    "src/explainer.js",
    "src/documents.js",
    "src/mcp-server.js",
    "src/evals.js",
    "src/eval-replay.js",
    "src/providers.js",
    "src/pc-tools.js",
    "src/activity.js",
    "src/approval-queue.js",
    "src/island-state.js",
    "src/app-sessions.js",
    "src/keys.js",
    "src/log.js",
    "src/latency.js",
    "src/early-tools.js",
    "src/hold-key.js",
    "src/model-results.js",
    "src/problem-report.js",
    "src/dev-hooks.js",
    "src/welcome.js",
    "src/costs.js",
    "src/scrub.js",
    "src/ui/pages.d.ts",
    "src/ui/settings.js",
    "src/ui/bubble.js",
    "src/ui/island.js",
    "src/ui/task.js",
    "src/ui/voice.js",
    "src/ui/marker.js",
    "src/ui/overlay.js"
  ]
}
